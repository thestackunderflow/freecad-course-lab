try:
    import FreeCADGui
    from PySide import QtWidgets
    QtWidgets.QApplication.processEvents()
    mw = FreeCADGui.getMainWindow()
    def px(w, p):
        k = w.devicePixelRatioF()
        g = w.mapToGlobal(p)
        return '%d %d' % (int(g.x() * k), int(g.y() * k))
    out = 'none'
    for b in mw.findChildren(QtWidgets.QAbstractButton):
        if out == 'none' and b.isVisible() and b.text().replace('&', '') == 'Cancel':
            out = px(b, b.rect().center())
    print(out)
except BaseException as _lab_e:
    print('LABERR' + " " + type(_lab_e).__name__ + ": " + str(_lab_e))

