try:
    import FreeCADGui
    from PySide import QtWidgets
    QtWidgets.QApplication.processEvents()
    mw = FreeCADGui.getMainWindow()
    def px(w, p):
        k = w.devicePixelRatioF()
        g = w.mapToGlobal(p)
        return '%d %d' % (int(g.x() * k), int(g.y() * k))
    out = 'none'
    for w in QtWidgets.QApplication.topLevelWidgets():
        if out == 'none' and w.isVisible() and isinstance(w, QtWidgets.QMessageBox):
            for b in w.buttons():
                out = px(b, b.rect().center())
    print(out)
except BaseException as _lab_e:
